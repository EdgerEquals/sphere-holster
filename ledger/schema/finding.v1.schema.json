{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/EdgerEquals/stratified-sphere-model/ledger/schema/finding.v1.schema.json",
  "title": "Stratified Sphere review ledger record, v1",
  "description": "One line of ledger/findings.jsonl. The file is append-only: records are never edited or removed; a later 'status' or 'mirror' record refers back to a finding by id.",
  "type": "object",
  "required": ["schema", "kind", "id", "recorded_utc", "source"],
  "properties": {
    "schema": {"const": "ssm-ledger/v1"},
    "kind": {"enum": ["finding", "status", "mirror", "cost", "gateway_run", "planted_run"]},
    "id": {"type": "string", "pattern": "^[0-9a-f]{16}$", "description": "First 16 hex chars of hash."},
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$", "description": "sha256 of the normalised dedup key."},
    "recorded_utc": {"type": "string", "format": "date-time"},
    "event_utc": {"type": ["string", "null"], "description": "When the reviewed event happened (review start / run time)."},
    "source": {
      "type": "object",
      "required": ["type", "ref"],
      "properties": {
        "type": {"enum": ["verdict_artifact", "review_round", "ping_artifact", "gateway", "planted", "issue", "manual"]},
        "ref": {"type": "string"},
        "run_id": {"type": ["string", "null"]},
        "head_sha": {"type": ["string", "null"]},
        "scope": {"type": ["string", "null"]}
      }
    },
    "reviewer": {"enum": ["Claude", "Grok", "Kimi", "DeepSeek", "Tavily", "Gateway", "Danny", "Cursor"]},
    "model": {"type": ["string", "null"]},
    "severity": {"enum": ["note", "minor", "major", "blocker"]},
    "domain": {"type": "string"},
    "file": {"type": "string"},
    "claim": {"type": "string"},
    "note": {"type": "string"},
    "review_verdict": {"enum": ["PASS", "FAIL", "ERROR", "SKIPPED", null]},
    "injection_flags": {"type": "array", "items": {"type": "string"}},
    "finding_id": {"type": "string", "pattern": "^[0-9a-f]{16}$", "description": "status/mirror: the finding this refers to."},
    "status": {"enum": ["open", "accepted", "rejected", "fixed"]},
    "issue_number": {"type": ["integer", "null"]},
    "tokens": {
      "type": "object",
      "properties": {
        "input": {"type": ["integer", "null"]},
        "cached": {"type": ["integer", "null"]},
        "cache_write": {"type": ["integer", "null"]},
        "output": {"type": ["integer", "null"]},
        "reasoning": {"type": ["integer", "null"]}
      }
    },
    "cost_usd": {"type": ["number", "null"]},
    "cost_basis": {"type": "string", "description": "reported | computed | unknown, plus price note."},
    "credits": {"type": ["number", "null"], "description": "Tavily credits."},
    "tool": {"type": "string"},
    "ok": {"type": "boolean"},
    "summary": {"type": "string"},
    "fixture": {"type": "string"},
    "planted_keys_hit": {"type": "array", "items": {"type": "string"}}
  },
  "allOf": [
    {"if": {"properties": {"kind": {"const": "finding"}}}, "then": {"required": ["reviewer", "severity", "domain", "file", "claim", "note", "status", "hash"]}},
    {"if": {"properties": {"kind": {"const": "status"}}}, "then": {"required": ["finding_id", "status"]}},
    {"if": {"properties": {"kind": {"const": "mirror"}}}, "then": {"required": ["finding_id", "issue_number"]}},
    {"if": {"properties": {"kind": {"const": "cost"}}}, "then": {"required": ["reviewer", "model", "tokens", "cost_usd", "cost_basis", "hash"]}},
    {"if": {"properties": {"kind": {"const": "gateway_run"}}}, "then": {"required": ["tool", "ok", "summary", "hash"]}}
  ]
}
